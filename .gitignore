!/tests/test_settings.py
!/tests/test_deployment.py
!/docs/
/docs/*
!/docs/deployment.md
!/docs/video-understanding-design.md

# Never track local credentials, platform profiles, databases, logs or images.
**/__pycache__/
*.py[cod]
.env
.env.*
**/permissions.json
*.db
*.db-*
*.sqlite*
*.log
*.pem
*.key
*.p12
*.pfx

