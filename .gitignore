# This workspace also contains private runtime material. Track only release files.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/LICENSE
!/__init__.py
!/main.py
!/metadata.yaml
!/_conf_schema.json
!/requirements.txt
!/sakura/
/sakura/*
!/sakura/__init__.py
!/sakura/runtime.py
!/sakura/settings.py
!/sakura/message_flow.py
!/sakura/permissions.py
!/sakura/web_reading.py
!/sakura/image_api.py
!/examples/
/examples/*
!/examples/env.example
!/requirements/
/requirements/*
!/requirements/dev.txt
!/scripts/
/scripts/*
!/scripts/check_release.py
!/tests/
/tests/*
!/tests/support.py
!/tests/test_sakura_runtime_context.py
!/tests/test_sakura_message_flow.py
!/tests/test_sakura_site_reading.py
!/tests/test_sakura_web_permissions.py
!/tests/test_settings.py
!/tests/test_deployment.py
!/docs/
/docs/*
!/docs/deployment.md

# Never track local credentials, platform profiles, databases, logs or images.
**/__pycache__/
*.py[cod]
.env
.env.*
**/permissions.json
*.db
*.db-*
*.sqlite*
*.log
*.pem
*.key
*.p12
*.pfx
