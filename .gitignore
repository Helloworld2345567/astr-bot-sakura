!/README.md
!/LICENSE
!/__init__.py
!/main.py
!/metadata.yaml
!/_conf_schema.json
!/requirements.txt
!/sakura/
/sakura/*
!/sakura/__init__.py
!/sakura/runtime.py
!/sakura/settings.py
!/sakura/message_flow.py
!/sakura/permissions.py
!/sakura/web_reading.py
!/skills/
/skills/*
!/skills/image-generation/
/skills/image-generation/*
