!/skills/image-generation/scripts/
/skills/image-generation/scripts/*
!/skills/image-generation/scripts/image_api.py
!/skills/image-generation/references/
/skills/image-generation/references/*
!/skills/image-generation/references/direct-api-contract.md
!/skills/image-generation/references/image-guidance.md
!/skills/image-generation/agents/
/skills/image-generation/agents/*
!/skills/image-generation/agents/openai.yaml
!/examples/
/examples/*
!/examples/env.example
!/requirements/
/requirements/*
!/requirements/dev.txt
!/scripts/
/scripts/*
!/scripts/check_release.py
!/tests/
/tests/*
!/tests/support.py
!/tests/test_sakura_runtime_context.py
!/tests/test_sakura_message_flow.py
!/tests/test_sakura_site_reading.py
